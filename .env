# ─── Django ────────────────────────────────────────────────
DJANGO_SETTINGS_MODULE=smpneed.settings
DEBUG=True
SECRET_KEY=replace-with-strong-random-string
ALLOWED_HOSTS=localhost,127.0.0.1

# ─── Database ──────────────────────────────────────────────
# SQLite (dev)
DATABASE_URL=sqlite:///db.sqlite3
# PostgreSQL (prod)
# DATABASE_URL=postgres://smp:smp_secret@localhost:5432/smp_need

# ─── Redis / Celery ────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0

# ─── CORS ──────────────────────────────────────────────────
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

# ─── Email ─────────────────────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@smp-need.app

# ─── Media / S3 ────────────────────────────────────────────
USE_S3=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=

# ─── JWT ───────────────────────────────────────────────────
ACCESS_TOKEN_LIFETIME_HOURS=2
REFRESH_TOKEN_LIFETIME_DAYS=7

# ─── Frontend ──────────────────────────────────────────────
VITE_API_BASE=http://127.0.0.1:8000/api
VITE_WS_BASE=ws://127.0.0.1:8000